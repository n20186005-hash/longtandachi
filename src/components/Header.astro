---
import Icon from './Icon.astro';
const nav = [
  ['景點亮點', '/#highlights'],
  ['散步路線', '/#routes'],
  ['交通停車', '/#transport'],
  ['周邊行程', '/#nearby'],
  ['常見問題', '/#faq'],
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-mist-50/88 shadow-sm shadow-lake-950/5 backdrop-blur-xl" data-site-header>
  <div class="shell flex h-[4.5rem] items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-3" aria-label="龍潭大池旅遊指南首頁">
      <span class="grid size-10 place-items-center rounded-2xl bg-lake-900 text-gold-300 shadow-md shadow-lake-950/15 transition group-hover:-rotate-3 group-hover:scale-105">
        <svg viewBox="0 0 42 42" class="size-7" aria-hidden="true">
          <path d="M4 26c7-6 12-6 18-3s10 3 16-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
          <path d="M10 16c5-6 11-7 18-4 3 1.5 6 1.5 9 0-1.8 6-6.5 9.5-13 9.5-5.5 0-9.4-2-14-5.5Z" fill="currentColor" opacity=".95"/>
        </svg>
      </span>
      <span class="leading-tight">
        <strong class="block font-serif text-lg tracking-[0.08em] text-lake-950">龍潭大池</strong>
        <span class="block text-[0.62rem] font-bold tracking-[0.2em] text-lake-700 uppercase">Longtan Dachi</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="主要導覽">
      {nav.map(([label, href]) => <a class="nav-link" href={href}>{label}</a>)}
    </nav>

    <div class="flex items-center gap-2">
      <a href="/#transport" class="hidden rounded-full bg-lake-900 px-5 py-2.5 text-sm font-bold text-white shadow-md shadow-lake-950/15 transition hover:-translate-y-0.5 hover:bg-lake-800 sm:inline-flex">開始規劃</a>
      <button type="button" class="grid size-11 place-items-center rounded-full border border-lake-900/10 bg-white text-lake-950 lg:hidden" aria-label="開啟選單" aria-expanded="false" data-menu-button>
        <span data-menu-open><Icon name="menu" class="size-5" /></span>
        <span class="hidden" data-menu-close><Icon name="close" class="size-5" /></span>
      </button>
    </div>
  </div>

  <div class="hidden border-t border-lake-900/8 bg-mist-50/98 lg:hidden" data-mobile-menu>
    <nav class="shell grid py-3" aria-label="行動版導覽">
      {nav.map(([label, href]) => <a class="border-b border-lake-900/7 py-3 text-sm font-bold text-lake-950 last:border-0" href={href}>{label}</a>)}
    </nav>
  </div>
</header>

<script is:inline>
  const button = document.querySelector('[data-menu-button]');
  const menu = document.querySelector('[data-mobile-menu]');
  const openIcon = document.querySelector('[data-menu-open]');
  const closeIcon = document.querySelector('[data-menu-close]');
  const closeMenu = () => {
    if (!button || !menu) return;
    button.setAttribute('aria-expanded', 'false');
    menu.classList.add('hidden');
    openIcon?.classList.remove('hidden');
    closeIcon?.classList.add('hidden');
  };
  button?.addEventListener('click', () => {
    const expanded = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden', expanded);
    openIcon?.classList.toggle('hidden', !expanded);
    closeIcon?.classList.toggle('hidden', expanded);
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
</script>
