---
interface Props {
  name: string;
  class?: string;
  label?: string;
}
const { name, class: className = 'size-5', label } = Astro.props;
const common: Record<string, string> = {
  class: className,
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.8',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  viewBox: '0 0 24 24',
  ...(label ? { role: 'img' } : { 'aria-hidden': 'true' }),
};
---

{label && <span class="sr-only">{label}</span>}
{name === 'ticket' && <svg {...common}><path d="M3 8.5A2.5 2.5 0 0 0 5.5 11 2.5 2.5 0 0 0 3 13.5V17a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-3.5A2.5 2.5 0 0 0 18.5 11 2.5 2.5 0 0 0 21 8.5V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v1.5Z"/><path d="M13 5v14"/></svg>}
{name === 'clock' && <svg {...common}><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/></svg>}
{name === 'sunset' && <svg {...common}><path d="M4 18h16M6 14a6 6 0 0 1 12 0M12 3v3M4.9 6.9 7 9M19.1 6.9 17 9M2 13h3M19 13h3"/></svg>}
{name === 'family' && <svg {...common}><circle cx="8" cy="8" r="3"/><circle cx="17" cy="9" r="2.5"/><path d="M2.5 20c.4-4.2 2.3-6.5 5.5-6.5s5.1 2.3 5.5 6.5M13 15.2c1-.8 2.2-1.2 3.6-1.2 2.8 0 4.4 2 4.9 5.5"/></svg>}
{name === 'arrow' && <svg {...common}><path d="M5 12h14M13 6l6 6-6 6"/></svg>}
{name === 'map-pin' && <svg {...common}><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>}
{name === 'menu' && <svg {...common}><path d="M4 7h16M4 12h16M4 17h16"/></svg>}
{name === 'close' && <svg {...common}><path d="m6 6 12 12M18 6 6 18"/></svg>}
{name === 'walking' && <svg {...common}><circle cx="13" cy="4" r="2"/><path d="m10 22 2-6-2-4 2-4 3 3h4M8 22l-1-5 3-5"/></svg>}
{name === 'camera' && <svg {...common}><path d="M4 7h3l1.5-2h7L17 7h3a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z"/><circle cx="12" cy="13" r="4"/></svg>}
{name === 'car' && <svg {...common}><path d="m5 11 2-5h10l2 5M4 11h16v7H4z"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/><path d="M4 14h3M17 14h3"/></svg>}
{name === 'bus' && <svg {...common}><rect x="5" y="3" width="14" height="16" rx="2"/><path d="M5 8h14M8 19v2M16 19v2M8 15h.01M16 15h.01"/></svg>}
{name === 'info' && <svg {...common}><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>}
{name === 'chevron' && <svg {...common}><path d="m8 10 4 4 4-4"/></svg>}
{name === 'sparkle' && <svg {...common}><path d="M12 3c.6 4.2 2.8 6.4 7 7-4.2.6-6.4 2.8-7 7-.6-4.2-2.8-6.4-7-7 4.2-.6 6.4-2.8 7-7Z"/><path d="M19 16c.3 2 1.3 3 3 3-1.7.3-2.7 1.3-3 3-.3-1.7-1.3-2.7-3-3 1.7-.3 2.7-1.3 3-3Z"/></svg>}
{name === 'star' && <svg {...common} fill="currentColor" stroke="none"><path d="M12 2.6l2.86 5.8 6.4.93-4.63 4.51 1.09 6.38L12 17.22l-5.72 3-1.09-6.38-4.63-4.51 6.4-.93L12 2.6Z"/></svg>}
{name === 'external' && <svg {...common}><path d="M14 4h6v6M20 4l-9 9M19 13.5V19a1.5 1.5 0 0 1-1.5 1.5h-12A1.5 1.5 0 0 1 4 19V7a1.5 1.5 0 0 1 1.5-1.5H10"/></svg>}
