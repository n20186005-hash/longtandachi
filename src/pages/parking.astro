---
import SubpageLayout from '../layouts/SubpageLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Icon from '../components/Icon.astro';
import { site, parkingFaqs } from '../data/site';

const slug = 'parking';
const canonicalPath = `/${slug}/`;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '龍潭大池', item: site.url },
      { '@type': 'ListItem', position: 2, name: '停車與交通', item: `${site.url}/parking/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: parkingFaqs.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: { '@type': 'Answer', text: item.answer },
    })),
  },
];
---

<SubpageLayout
  title="龍潭大池停車與交通｜地址、導航、公車與活動期間提醒"
  description="龍潭大池怎麼去？整理桃園龍潭大池地址、Google 地圖一鍵導航、周邊停車與公車站資訊，以及龍舟賽等大型活動期間的交通調整提醒。"
  canonicalPath={canonicalPath}
  structuredData={structuredData}
  eyebrow="停車與交通"
  heroTitle="龍潭大池停車與交通"
  heroLead="找到正確入口，抵達後就能輕鬆開始。這裡整理龍潭大池的地址、一鍵導航、公車站與停車原則，也提醒你大型活動期間的交通變化。"
  heroImage="longtan-blue-hour"
  currentSlug={slug}
>
  <section class="py-20 md:py-28" id="location">
    <div class="shell grid gap-8 lg:grid-cols-[1.05fr_0.95fr]">
      <div class="soft-card overflow-hidden" data-reveal>
        <div class="relative min-h-[380px] bg-lake-100 md:min-h-[460px]">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3620.0087013832035!2d121.20944949999999!3d24.8635524!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x34683cfb3e3b6b19%3A0x613ddf8e79949ff3!2z6b6Z5r2t5aSn5rGg!5e0!3m2!1szh-CN!2stw!4v1785313685696!5m2!1szh-CN!2stw"
            width="600"
            height="450"
            class="absolute inset-0 h-full w-full border-0"
            title="龍潭大池 Google 地圖"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
        <div class="flex flex-col gap-5 bg-lake-900 p-7 text-white sm:flex-row sm:items-center sm:justify-between md:p-8">
          <div>
            <p class="text-xs font-bold tracking-[0.2em] text-gold-300">LOCATION</p>
            <h2 class="mt-2 font-serif text-2xl font-semibold">龍潭觀光大池</h2>
            <p class="mt-2 max-w-lg text-sm leading-7 text-white/70">{site.address}</p>
          </div>
          <a href={site.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center gap-2 self-start rounded-full bg-gold-300 px-5 py-3 text-sm font-bold text-lake-950 transition hover:-translate-y-0.5 hover:bg-white sm:self-auto">
            開啟地圖導航 <Icon name="arrow" class="size-4" />
          </a>
        </div>
      </div>

      <div class="grid gap-5" data-reveal>
        <article class="soft-card p-7 md:p-8">
          <div class="flex gap-5">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-lake-100 text-lake-800"><Icon name="map-pin" class="size-6" /></span>
            <div>
              <h3 class="font-serif text-2xl font-semibold text-lake-950">地址與座標</h3>
              <p class="mt-3 text-sm leading-7 text-ink-700">可直接以地址「桃園市龍潭區中豐路上林段115巷11號」設定導航，或以座標 <span class="font-bold text-lake-950">24.8636, 121.2094</span> 開啟 Google 地圖。本站亦提供上方一鍵導航連結。</p>
            </div>
          </div>
        </article>
        <article class="soft-card p-7 md:p-8">
          <div class="flex gap-5">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-temple-100 text-temple-700"><Icon name="bus" class="size-6" /></span>
            <div>
              <h3 class="font-serif text-2xl font-semibold text-lake-950">大眾運輸</h3>
              <p class="mt-3 text-sm leading-7 text-ink-700">可在龍潭市區轉乘公車，於「龍潭大池」或「龍潭大池（神龍路）」站下車。路線班次與假日觀光公車可能調整，出發當日應再次確認。</p>
            </div>
          </div>
        </article>
        <article class="rounded-[1.75rem] border border-gold-500/35 bg-gold-300/18 p-7 md:p-8">
          <div class="flex gap-4">
            <span class="mt-0.5 text-temple-700"><Icon name="info" class="size-6" /></span>
            <div>
              <h3 class="font-bold text-lake-950">步行到主要景點</h3>
              <p class="mt-2 text-sm leading-7 text-ink-700">從周邊停車處步行至觀光吊橋、南天宮與湖畔步道只需數分鐘，實際距離依當日停車位置而異。建議把車停在靠近入口處，減少推車與長輩的步行負擔。</p>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-20 md:py-28" id="parking">
    <div class="shell">
      <SectionTitle
        eyebrow="停車原則"
        title="龍潭大池怎麼停車？"
        description="大池周邊入口與停車位置會受到活動、交通管制與現場狀況影響。本站提供穩定的到達方向，不承諾單一停車位一定可用。"
      />
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        <article class="soft-card p-7" data-reveal>
          <span class="grid size-12 place-items-center rounded-2xl bg-lake-100 text-lake-800"><Icon name="car" class="size-6" /></span>
          <h3 class="mt-5 font-serif text-xl font-semibold text-lake-950">周邊停車空間</h3>
          <p class="mt-3 text-sm leading-7 text-ink-700">可導航至龍潭大池或南天宮周邊，再依現場指示尋找公有、民營停車空間與合法路邊停車格。收費標準隨場域而異，以現場告示為準。</p>
        </article>
        <article class="soft-card p-7" data-reveal>
          <span class="grid size-12 place-items-center rounded-2xl bg-temple-100 text-temple-700"><Icon name="clock" class="size-6" /></span>
          <h3 class="mt-5 font-serif text-xl font-semibold text-lake-950">提早抵達</h3>
          <p class="mt-3 text-sm leading-7 text-ink-700">假日與午後時段車位較緊張；若安排黃昏夜景，建議下午四點前到達，預留找車位與步行緩衝。</p>
        </article>
        <article class="soft-card p-7" data-reveal>
          <span class="grid size-12 place-items-center rounded-2xl bg-gold-300/35 text-[#805611]"><Icon name="info" class="size-6" /></span>
          <h3 class="mt-5 font-serif text-xl font-semibold text-lake-950">當日確認</h3>
          <p class="mt-3 text-sm leading-7 text-ink-700">停車格開放與收費可能臨時調整，出發前可先查詢桃園市停車資訊或現場指示，避免依舊資訊白跑一趟。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28" id="events">
    <div class="shell">
      <div class="relative overflow-hidden rounded-[2.5rem] bg-lake-900 p-8 text-white shadow-soft md:p-12 lg:p-16" data-reveal>
        <div class="pointer-events-none absolute -top-32 -right-24 size-96 rounded-full border border-white/10"></div>
        <div class="pointer-events-none absolute -top-12 -right-8 size-64 rounded-full border border-gold-300/20"></div>
        <div class="relative grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:items-center">
          <div>
            <p class="text-xs font-bold tracking-[0.2em] text-gold-300">EVENT DAYS</p>
            <h2 class="mt-4 font-serif text-3xl font-semibold md:text-5xl">大型活動日的交通提醒</h2>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {[
              ['龍舟賽', '端午前後周邊道路可能實施臨時管制。'],
              ['煙火與市集', '熱門活動日車流集中，平日車位也可能暫停開放。'],
              ['交通指示', '看到現場交通指示時，請以現場安排為優先。'],
              ['抵達建議', '提早出發並預留步行距離，比現場找位更從容。'],
            ].map(([title, text]) => (
              <div class="rounded-2xl border border-white/12 bg-white/7 p-5 backdrop-blur">
                <p class="font-bold text-gold-300">{title}</p>
                <p class="mt-2 text-sm leading-6 text-white/65">{text}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-mist-100 py-20 md:py-28" id="faq">
    <div class="shell grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
      <div>
        <SectionTitle
          eyebrow="常見問題"
          title="停車與交通，先回答這幾件小事"
          description="資訊可能隨活動與維護調整，因此本站避免把不穩定的營業時刻寫成永久規則。"
        />
      </div>
      <div class="grid gap-3" data-reveal>
        {parkingFaqs.map((faq, index) => (
          <details class="group rounded-2xl border border-lake-900/8 bg-white px-6 py-1 shadow-sm" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-bold text-lake-950 marker:hidden">
              <span>{faq.question}</span>
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-lake-50 text-lake-800 transition group-open:rotate-180"><Icon name="chevron" class="size-4" /></span>
            </summary>
            <p class="border-t border-lake-900/8 pb-6 pt-4 text-sm leading-7 text-ink-700">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</SubpageLayout>
